GOOGLE_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_API_KEY=
LLM_PROVIDER=gemini

# Database — SQLite for dev, Postgres in production.
DATABASE_URL=sqlite+aiosqlite:///./aria.db
# Example prod:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/aria

# Auth
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
