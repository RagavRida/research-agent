GOOGLE_API_KEY=
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_API_KEY=
OPENROUTER_API_KEY=your_openrouter_key_here
# One of: gemini | groq | openrouter
LLM_PROVIDER=openrouter
# Optional: override default OpenRouter models
# OPENROUTER_MODEL_FAST=google/gemini-2.0-flash-exp:free
# OPENROUTER_MODEL_PRO=deepseek/deepseek-chat-v3.1:free

# Database — SQLite for dev, Postgres in production.
DATABASE_URL=sqlite+aiosqlite:///./aria.db
# Example prod:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/aria

# Auth
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
