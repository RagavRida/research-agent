# ──────────────────────────────────────────────────────────
# ARIA — Research Agent backend — environment variables
# Copy this file to `.env` and fill in the blanks.
# ──────────────────────────────────────────────────────────

# ─── LLM provider (pick one) ───
# Options: "openrouter" (default), "gemini", "groq"
LLM_PROVIDER=openrouter

# ─── OpenRouter ─── (one key, dozens of models — recommended)
# Get from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL_PRO=deepseek/deepseek-chat-v3.1:free

# ─── Gemini direct ─── (only if LLM_PROVIDER=gemini)
# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ─── Groq ─── (only if LLM_PROVIDER=groq)
# Get from https://console.groq.com/keys
GROQ_API_KEY=

# ─── Tavily (required for all search tools) ───
# Get from https://app.tavily.com/home (API Keys)
TAVILY_API_KEY=

# ─── JWT auth ───
# Generate a strong secret: `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080   # 7 days

# ─── Database ───
# Local dev default is SQLite; prod uses Neon Postgres.
# Neon: use `?ssl=require` (NOT `sslmode=require` — asyncpg rejects it)
#       use the direct (non-pooler) endpoint with asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./aria.db
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require

# ─── Server ───
# Railway / Render set this automatically in prod.
PORT=8000
